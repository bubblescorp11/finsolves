---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us — Finsolves"
  description="Get in touch with the Finsolves team. Schedule a consultation, ask a question, or learn how we can help with your SAP Group Reporting needs."
>
  <Navbar />
  <main>
    <section class="pt-28 pb-12 bg-linear-to-br from-slate-50 via-blue-50/30 to-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-primary-600 text-xs font-semibold uppercase tracking-widest mb-3">Let's Talk</p>
        <h1 class="font-display font-extrabold text-4xl lg:text-5xl text-navy-900 mb-4 leading-tight">Get in Touch</h1>
        <p class="text-slate-500 text-lg max-w-xl mx-auto">
          Have a question or ready to start your SAP Group Reporting journey? Our experts are here to help.
        </p>
      </div>
    </section>

    <section class="py-14 lg:py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">

          <!-- Left: Info Cards -->
          <div class="lg:col-span-2 flex flex-col gap-5">
            <div>
              <h2 class="font-display font-bold text-2xl text-navy-900 mb-2">We'd love to hear from you</h2>
              <p class="text-slate-500 text-sm leading-relaxed">
                Fill in the form and a member of our team will respond within one business day.
              </p>
            </div>
            {[
              {
                icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
                title: 'Email Us', value: 'info@finsolves.com', sub: 'We reply within 24 hours',
              },
              {
                icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
                title: 'Call Us', value: '+1 (800) 123-4567', sub: 'Mon–Fri, 9am–6pm EST',
              },
              {
                icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
                title: 'Visit Us', value: 'New York, NY 10001', sub: 'Global delivery team',
              },
            ].map((item) => (
              <div class="flex items-start gap-4 p-5 rounded-xl border border-slate-100 hover:border-primary-100 hover:shadow-card-hover transition-all duration-300">
                <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" set:html={item.icon} />
                </div>
                <div>
                  <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5">{item.title}</div>
                  <div class="font-semibold text-navy-900 text-sm">{item.value}</div>
                  <div class="text-slate-400 text-xs mt-0.5">{item.sub}</div>
                </div>
              </div>
            ))}
          </div>

          <!-- Right: Contact Form -->
          <div class="lg:col-span-3">
            <div class="bg-white border border-slate-100 rounded-2xl p-8 lg:p-10 shadow-card">
              <h3 class="font-display font-bold text-xl text-navy-900 mb-7">Send us a message</h3>
              <form id="contact-form" novalidate class="space-y-5">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label for="name" class="block text-sm font-medium text-slate-700 mb-1.5">
                      Full Name <span class="text-red-500">*</span>
                    </label>
                    <input
                      id="name" name="name" type="text" autocomplete="name" required
                      placeholder="Jane Smith"
                      class="w-full px-4 py-3 rounded-lg border border-slate-200 text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:border-primary-400 transition-colors"
                    />
                    <p class="hidden text-xs text-red-500 mt-1" id="name-error">Please enter your full name.</p>
                  </div>
                  <div>
                    <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">
                      Email Address <span class="text-red-500">*</span>
                    </label>
                    <input
                      id="email" name="email" type="email" autocomplete="email" required
                      placeholder="jane@company.com"
                      class="w-full px-4 py-3 rounded-lg border border-slate-200 text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:border-primary-400 transition-colors"
                    />
                    <p class="hidden text-xs text-red-500 mt-1" id="email-error">Please enter a valid email address.</p>
                  </div>
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Phone Number <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="phone" name="phone" type="tel" autocomplete="tel" required
                    placeholder="+1 (555) 000-0000"
                    class="w-full px-4 py-3 rounded-lg border border-slate-200 text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:border-primary-400 transition-colors"
                  />
                  <p class="hidden text-xs text-red-500 mt-1" id="phone-error">Please enter your phone number.</p>
                </div>
                <div>
                  <label for="query" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Query Details <span class="text-red-500">*</span>
                  </label>
                  <textarea
                    id="query" name="query" rows="5" required
                    placeholder="Tell us about your project, requirements, or questions..."
                    class="w-full px-4 py-3 rounded-lg border border-slate-200 text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:border-primary-400 transition-colors resize-none"
                  ></textarea>
                  <p class="hidden text-xs text-red-500 mt-1" id="query-error">Please describe your query.</p>
                </div>
                <button
                  type="submit" id="submit-btn"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 active:bg-primary-800 transition-colors text-[15px] shadow-sm"
                >
                  <span id="btn-text">Send Message</span>
                  <svg id="btn-arrow" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                  <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                  </svg>
                </button>
                <div id="success-msg" class="hidden flex items-start gap-3 bg-emerald-50 border border-emerald-200 rounded-lg px-4 py-3">
                  <svg class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <div>
                    <p class="text-emerald-800 text-sm font-semibold">Message sent successfully!</p>
                    <p class="text-emerald-700 text-xs mt-0.5">Thank you for reaching out. Our team will contact you within one business day.</p>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btnText = document.getElementById('btn-text');
  const btnArrow = document.getElementById('btn-arrow');
  const btnSpinner = document.getElementById('btn-spinner');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('success-msg');

  function setFieldError(inputId: string, errorId: string, hasError: boolean) {
    const input = document.getElementById(inputId);
    const errEl = document.getElementById(errorId);
    errEl?.classList.toggle('hidden', !hasError);
    if (hasError) {
      input?.classList.add('border-red-300');
      input?.classList.remove('border-slate-200');
    } else {
      input?.classList.remove('border-red-300');
      input?.classList.add('border-slate-200');
    }
  }

  function validateForm(): boolean {
    let valid = true;
    const name = (document.getElementById('name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
    const query = (document.getElementById('query') as HTMLTextAreaElement)?.value.trim();

    if (!name) { setFieldError('name','name-error',true); valid=false; } else { setFieldError('name','name-error',false); }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setFieldError('email','email-error',true); valid=false; } else { setFieldError('email','email-error',false); }
    if (!phone) { setFieldError('phone','phone-error',true); valid=false; } else { setFieldError('phone','phone-error',false); }
    if (!query || query.length < 10) { setFieldError('query','query-error',true); valid=false; } else { setFieldError('query','query-error',false); }
    return valid;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validateForm()) return;
    submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Sending...';
    btnArrow?.classList.add('hidden');
    btnSpinner?.classList.remove('hidden');
    await new Promise(r => setTimeout(r, 1400));
    if (btnText) btnText.textContent = 'Send Message';
    btnArrow?.classList.remove('hidden');
    btnSpinner?.classList.add('hidden');
    submitBtn.disabled = false;
    successMsg?.classList.remove('hidden');
    form.reset();
    setTimeout(() => successMsg?.classList.add('hidden'), 6000);
  });
</script>
