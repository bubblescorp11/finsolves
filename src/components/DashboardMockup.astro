---
// SAP Group Reporting Dashboard Mockup
---

<div class="relative w-full max-w-[680px] ml-auto">
  <!-- Outer shadow card -->
  <div class="relative rounded-2xl overflow-hidden shadow-dashboard border border-slate-200">
    <div class="flex" style="min-height:430px;">

      <!-- Left Sidebar -->
      <div class="bg-[#0f1f3d] text-white flex-shrink-0" style="width:176px;">
        <!-- SAP Header -->
        <div class="px-4 py-3.5 border-b border-white/10">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded flex items-center justify-center bg-[#0070d2]">
              <span class="text-white font-bold text-[10px]">SAP</span>
            </div>
            <div>
              <div class="text-[10px] font-semibold text-white leading-tight">Group</div>
              <div class="text-[10px] font-semibold text-white leading-tight">Reporting</div>
            </div>
          </div>
        </div>
        <!-- Sidebar nav -->
        <nav class="py-2">
          {[
            { icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6', label: 'Home', active: true },
            { icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z', label: 'Consolidation', active: false },
            { icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z', label: 'Data Monitoring', active: false },
            { icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', label: 'Journals', active: false },
            { icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z', label: 'Reports', active: false },
            { icon: 'M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z', label: 'Analytics', active: false },
            { icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4', label: 'Tasks', active: false },
            { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', label: 'Audit & Compliance', active: false },
            { icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z', label: 'Administration', active: false },
          ].map((item) => (
            <div class={`flex items-center gap-2.5 px-4 py-2 mx-2 rounded-md cursor-pointer text-[11px] font-medium ${item.active ? 'bg-[#2563eb] text-white' : 'text-slate-300 hover:bg-white/10'}`}>
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}/>
              </svg>
              <span class="truncate">{item.label}</span>
            </div>
          ))}
        </nav>
      </div>

      <!-- Right Panel -->
      <div class="flex-1 bg-[#f8fafc] overflow-hidden">
        <!-- Top bar -->
        <div class="bg-white border-b border-slate-100 px-4 py-2.5 flex items-center justify-between">
          <span class="text-[13px] font-semibold text-slate-800">Group Overview</span>
          <div class="flex items-center gap-2">
            <div class="flex items-center gap-1 bg-slate-100 text-slate-600 text-[10px] font-medium px-2.5 py-1 rounded-md">
              FY 2024 <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <div class="flex items-center gap-1 bg-slate-100 text-slate-600 text-[10px] font-medium px-2.5 py-1 rounded-md">
              All Entities <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <div class="w-6 h-6 rounded-full bg-slate-300 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
          </div>
        </div>

        <div class="p-3 space-y-2.5 overflow-auto">
          <!-- Metric Cards Row -->
          <div class="grid grid-cols-4 gap-2">
            {[
              { label: 'Total Revenue', value: '$8.42B', change: '+12.6% vs FY 2023', up: true },
              { label: 'Operating Profit', value: '$1.75B', change: '+8.7% vs FY 2023', up: true },
              { label: 'Net Income', value: '$1.23B', change: '+9.3% vs FY 2023', up: true },
              { label: 'Total Assets', value: '$24.6B', change: '+7.1% vs FY 2023', up: true },
            ].map((metric) => (
              <div class="bg-white rounded-lg p-2.5 border border-slate-100">
                <div class="text-[9px] text-slate-500 mb-1">{metric.label}</div>
                <div class="flex items-center justify-between">
                  <span class="text-[13px] font-bold text-slate-800">{metric.value}</span>
                  <svg class="w-8 h-5" viewBox="0 0 32 20" fill="none">
                    <polyline points="2,16 8,10 14,13 20,6 26,8 30,3" stroke="#22c55e" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div class="flex items-center gap-0.5 mt-0.5">
                  <svg class="w-2.5 h-2.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                  <span class="text-[8px] text-emerald-600 font-medium">{metric.change}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Charts Row -->
          <div class="grid grid-cols-2 gap-2">
            <!-- Financial Performance Bar Chart -->
            <div class="bg-white rounded-lg p-3 border border-slate-100">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-semibold text-slate-700">Financial Performance</span>
                <div class="flex items-center gap-2 text-[8px] text-slate-500">
                  <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-primary-500 inline-block"></span>Revenue</span>
                  <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-primary-200 inline-block"></span>Net Income</span>
                </div>
              </div>
              <!-- Bar chart SVG -->
              <svg viewBox="0 0 200 90" class="w-full h-[80px]">
                <!-- Grid lines -->
                <line x1="30" y1="10" x2="200" y2="10" stroke="#f1f5f9" stroke-width="0.5"/>
                <line x1="30" y1="28" x2="200" y2="28" stroke="#f1f5f9" stroke-width="0.5"/>
                <line x1="30" y1="46" x2="200" y2="46" stroke="#f1f5f9" stroke-width="0.5"/>
                <line x1="30" y1="64" x2="200" y2="64" stroke="#f1f5f9" stroke-width="0.5"/>
                <!-- Y axis labels -->
                <text x="26" y="13" text-anchor="end" class="text-[6px]" fill="#94a3b8" font-size="6">10B</text>
                <text x="26" y="31" text-anchor="end" class="text-[6px]" fill="#94a3b8" font-size="6">8B</text>
                <text x="26" y="49" text-anchor="end" class="text-[6px]" fill="#94a3b8" font-size="6">6B</text>
                <text x="26" y="67" text-anchor="end" class="text-[6px]" fill="#94a3b8" font-size="6">4B</text>
                <!-- FY2021 bars -->
                <rect x="38" y="55" width="8" height="19" rx="1" fill="#93c5fd"/>
                <rect x="48" y="62" width="8" height="12" rx="1" fill="#bfdbfe"/>
                <!-- FY2022 bars -->
                <rect x="82" y="44" width="8" height="30" rx="1" fill="#60a5fa"/>
                <rect x="92" y="57" width="8" height="17" rx="1" fill="#bfdbfe"/>
                <!-- FY2023 bars -->
                <rect x="126" y="33" width="8" height="41" rx="1" fill="#3b82f6"/>
                <rect x="136" y="52" width="8" height="22" rx="1" fill="#93c5fd"/>
                <!-- FY2024 bars -->
                <rect x="170" y="21" width="8" height="53" rx="1" fill="#2563eb"/>
                <rect x="180" y="42" width="8" height="32" rx="1" fill="#60a5fa"/>
                <!-- X labels -->
                <text x="47" y="82" text-anchor="middle" fill="#94a3b8" font-size="6">FY 2021</text>
                <text x="91" y="82" text-anchor="middle" fill="#94a3b8" font-size="6">FY 2022</text>
                <text x="135" y="82" text-anchor="middle" fill="#94a3b8" font-size="6">FY 2023</text>
                <text x="179" y="82" text-anchor="middle" fill="#94a3b8" font-size="6">FY 2024</text>
              </svg>
            </div>

            <!-- Entity Performance World Map -->
            <div class="bg-white rounded-lg p-3 border border-slate-100">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-semibold text-slate-700">Entity Performance</span>
              </div>
              <!-- Simplified world map SVG -->
              <div class="relative">
                <svg viewBox="0 0 200 85" class="w-full h-[75px]" fill="none">
                  <!-- Americas -->
                  <ellipse cx="45" cy="38" rx="18" ry="22" fill="#bfdbfe" opacity="0.7"/>
                  <ellipse cx="52" cy="55" rx="12" ry="15" fill="#93c5fd" opacity="0.8"/>
                  <!-- Europe -->
                  <ellipse cx="95" cy="30" rx="14" ry="16" fill="#3b82f6" opacity="0.75"/>
                  <!-- Africa -->
                  <ellipse cx="98" cy="55" rx="11" ry="18" fill="#60a5fa" opacity="0.65"/>
                  <!-- Asia -->
                  <ellipse cx="148" cy="32" rx="30" ry="20" fill="#2563eb" opacity="0.6"/>
                  <!-- Australia -->
                  <ellipse cx="162" cy="60" rx="14" ry="10" fill="#93c5fd" opacity="0.7"/>
                  <!-- Dots for entities -->
                  <circle cx="95" cy="28" r="2.5" fill="#1d4ed8"/>
                  <circle cx="45" cy="36" r="2" fill="#60a5fa"/>
                  <circle cx="148" cy="28" r="2.5" fill="#1d4ed8"/>
                  <circle cx="162" cy="58" r="2" fill="#60a5fa"/>
                  <circle cx="52" cy="52" r="1.5" fill="#93c5fd"/>
                </svg>
                <!-- Legend -->
                <div class="absolute bottom-0 right-0 flex flex-col gap-0.5">
                  <div class="flex items-center gap-1 text-[7px] text-slate-500"><span class="w-2 h-2 rounded-full bg-primary-700 inline-block"></span>High</div>
                  <div class="flex items-center gap-1 text-[7px] text-slate-500"><span class="w-2 h-2 rounded-full bg-primary-400 inline-block"></span>Medium</div>
                  <div class="flex items-center gap-1 text-[7px] text-slate-500"><span class="w-2 h-2 rounded-full bg-primary-200 inline-block"></span>Low</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Row -->
          <div class="grid grid-cols-3 gap-2">
            <!-- Close Status -->
            <div class="bg-white rounded-lg p-2.5 border border-slate-100">
              <div class="text-[9px] font-semibold text-slate-700 mb-2">Close Status</div>
              <div class="flex items-center gap-2">
                <div class="relative w-12 h-12 flex-shrink-0">
                  <svg viewBox="0 0 44 44" class="w-12 h-12 -rotate-90">
                    <circle cx="22" cy="22" r="16" fill="none" stroke="#f1f5f9" stroke-width="5"/>
                    <circle cx="22" cy="22" r="16" fill="none" stroke="#2563eb" stroke-width="5"
                      stroke-dasharray="85 100" stroke-linecap="round"/>
                  </svg>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-[10px] font-bold text-slate-800">85%</span>
                  </div>
                </div>
                <div>
                  <div class="text-[9px] font-semibold text-slate-700">Consolidation Progress</div>
                  <div class="flex items-center gap-0.5 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                    <span class="text-[8px] text-emerald-600">+12% vs last month</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Data Quality -->
            <div class="bg-white rounded-lg p-2.5 border border-slate-100">
              <div class="text-[9px] font-semibold text-slate-700 mb-2">Data Quality</div>
              <div class="flex items-center gap-2">
                <div class="relative w-12 h-12 flex-shrink-0">
                  <svg viewBox="0 0 44 44" class="w-12 h-12 -rotate-90">
                    <circle cx="22" cy="22" r="16" fill="none" stroke="#f1f5f9" stroke-width="5"/>
                    <circle cx="22" cy="22" r="16" fill="none" stroke="#10b981" stroke-width="5"
                      stroke-dasharray="92 100" stroke-linecap="round"/>
                  </svg>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-[10px] font-bold text-slate-800">92%</span>
                  </div>
                </div>
                <div>
                  <div class="text-[9px] font-semibold text-slate-700">Data Quality Score</div>
                  <div class="text-[8px] text-emerald-600 font-medium mt-0.5">High data quality</div>
                </div>
              </div>
            </div>

            <!-- Top Exceptions -->
            <div class="bg-white rounded-lg p-2.5 border border-slate-100">
              <div class="text-[9px] font-semibold text-slate-700 mb-2">Top Exceptions</div>
              <div class="space-y-1">
                {[
                  { label: 'Intercompany Differences', count: 23 },
                  { label: 'Currency Translation', count: 17 },
                  { label: 'Data Validation', count: 12 },
                ].map((item) => (
                  <div class="flex items-center justify-between">
                    <span class="text-[8px] text-slate-500 truncate flex-1 mr-1">{item.label}</span>
                    <span class="text-[8px] font-semibold text-slate-700">{item.count}</span>
                  </div>
                ))}
              </div>
              <div class="mt-1.5 flex items-center gap-0.5 text-primary-600">
                <span class="text-[8px] font-medium">View all exceptions</span>
                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
