---
const currentYear = new Date().getFullYear();
const withBase = (path) => `${import.meta.env.BASE_URL}${path === '/' ? '' : path.replace(/^\//, '')}`;
---

<footer class="bg-navy-900 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href={withBase('/')} class="flex items-center gap-2.5 mb-4">
          <div class="flex items-end gap-[3px] h-7">
            <div class="w-[5px] h-3 bg-primary-500 rounded-sm"></div>
            <div class="w-[5px] h-5 bg-primary-500 rounded-sm"></div>
            <div class="w-[5px] h-7 bg-primary-500 rounded-sm"></div>
            <div class="w-[5px] h-4 bg-primary-400 rounded-sm"></div>
          </div>
          <span class="font-display font-bold text-xl text-white tracking-tight">Fin<span class="text-primary-400">solves</span></span>
        </a>
        <p class="text-sm leading-relaxed max-w-xs mb-5">
          Expert SAP Group Reporting solutions to streamline your financial consolidation and drive trusted insights across your global organization.
        </p>
        <div class="flex gap-3">
          {['M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 6a2 2 0 100-4 2 2 0 000 4z', 'M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z'].map(path => (
            <a href="#" class="w-8 h-8 rounded-md bg-white/10 flex items-center justify-center hover:bg-primary-600 transition-colors">
              <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={path}/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-white text-sm font-semibold mb-4">Company</h4>
        <ul class="space-y-2.5">
          {[
            { label: 'Home', href: '/' },
            { label: 'Services', href: '/services' },
            { label: 'About Us', href: '/about' },
            { label: 'Contact', href: '/contact' },
          ].map(link => (
            <li>
              <a href={withBase(link.href)} class="text-sm hover:text-white hover:text-primary-400 transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white text-sm font-semibold mb-4">Contact</h4>
        <ul class="space-y-2.5 text-sm">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>info@finsolves.com</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>+1 (800) 123-4567</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Global Headquarters<br/>New York, NY 10001</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <p>&copy; {currentYear} Finsolves. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="#" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-slate-300 transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
