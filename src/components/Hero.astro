---
import DashboardMockup from './DashboardMockup.astro';
const withBase = (path) => `${import.meta.env.BASE_URL}${path === '/' ? '' : path.replace(/^\//, '')}`;
---

<section class="relative pt-28 pb-12 lg:pt-32 lg:pb-16 overflow-hidden bg-linear-to-br from-slate-50 via-blue-50/30 to-white">
  <!-- Background decorative blobs -->
  <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-primary-100/40 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/3 pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-blue-100/30 rounded-full blur-3xl translate-x-1/3 translate-y-1/4 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-8">

      <!-- Left: Text Content -->
      <div class="w-full lg:w-[44%] flex-shrink-0 text-center lg:text-left">
        <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-[2.85rem] xl:text-5xl leading-[1.1] text-navy-900 mb-5">
          Transform Financial<br />
          Consolidation with<br />
          <span class="text-primary-600">SAP Group Reporting</span>
        </h1>
        <p class="text-slate-500 text-base lg:text-[17px] leading-relaxed mb-8 max-w-[420px] mx-auto lg:mx-0">
          Streamline your financial close, ensure compliance, and deliver trusted insights across your global organization.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 mb-12">
          <a
            href={withBase('/services')}
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors shadow-sm text-[15px]"
          >
            Explore Our Solution
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a
            href={withBase('/contact')}
            class="inline-flex items-center gap-2 px-6 py-3 border border-slate-200 text-slate-700 font-semibold rounded-lg hover:border-primary-300 hover:text-primary-600 hover:bg-primary-50 transition-colors text-[15px] bg-white"
          >
            Talk to an Expert
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </a>
        </div>

        <!-- Stats row -->
        <div class="grid grid-cols-3 gap-4 border-t border-slate-100 pt-8">
          {[
            {
              icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
              title: 'Faster Financial Close',
              desc: 'Reduce close cycles by up to 50%',
            },
            {
              icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
              title: 'Trusted & Compliant',
              desc: 'Meet regulatory requirements with confidence',
            },
            {
              icon: 'M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
              title: 'Actionable Insights',
              desc: 'Drive better decisions with real-time data',
            },
          ].map((item) => (
            <div class="flex flex-col items-center lg:items-start gap-2 text-center lg:text-left">
              <div class="w-9 h-9 rounded-lg bg-primary-50 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}/>
                </svg>
              </div>
              <div>
                <div class="text-[13px] font-semibold text-navy-900">{item.title}</div>
                <div class="text-[11px] text-slate-500 leading-snug mt-0.5">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Dashboard Mockup -->
      <div class="w-full lg:flex-1">
        <DashboardMockup />
      </div>
    </div>
  </div>
</section>
