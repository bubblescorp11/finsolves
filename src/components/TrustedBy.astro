---
const logos = [
  { name: 'Alsco', letters: 'ALSCO', style: 'font-extrabold text-2xl tracking-wider' },
  { name: 'Dole', letters: 'Dole', style: 'font-bold text-2xl italic border-2 border-current rounded-full px-3 py-1' },
  { name: 'Jabil', letters: 'JABIL', style: 'font-black text-2xl tracking-widest' },
  { name: 'Luxottica', letters: 'LUXOTTICA', style: 'font-light text-xl tracking-[0.2em]' },
  { name: 'Evonik', letters: 'EVONIK', style: 'font-semibold text-xl tracking-wide' },
];
---

<section class="py-16 lg:py-20 bg-slate-50/60 border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-primary-600 text-xs font-semibold uppercase tracking-widest mb-10 text-center lg:text-left">
      Trusted by Finance Leaders
    </p>
    <div class="flex flex-wrap justify-center lg:justify-start items-center gap-10 lg:gap-16">
      {logos.map((logo) => (
        <div class={`text-slate-400 hover:text-slate-600 transition-colors cursor-default select-none ${logo.style}`}>
          {logo.letters}
        </div>
      ))}
    </div>
  </div>
</section>
