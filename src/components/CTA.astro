---
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-2xl bg-linear-to-br from-navy-800 via-[#1a3a6e] to-[#0f2a5a] p-10 lg:p-14">
      <!-- Background grid pattern -->
      <div class="absolute inset-0 opacity-5">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid)"/>
        </svg>
      </div>

      <div class="relative flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="max-w-lg text-center lg:text-left">
          <h2 class="font-display font-bold text-white text-2xl lg:text-3xl xl:text-[2rem] leading-snug mb-3">
            Ready to Elevate Your Financial Reporting?
          </h2>
          <p class="text-blue-200 text-[15px] leading-relaxed">
            Our SAP experts help you implement, optimize, and evolve SAP Group Reporting to drive lasting value.
          </p>
          <div class="mt-7">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-6 py-3 bg-white text-navy-900 font-semibold rounded-lg hover:bg-blue-50 transition-colors text-[15px] shadow-sm"
            >
              Schedule a Consultation
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Decorative chart illustration -->
        <div class="hidden lg:flex items-end gap-3 opacity-30">
          <svg viewBox="0 0 180 120" class="w-44" fill="none">
            <rect x="10" y="80" width="22" height="35" rx="3" fill="#60a5fa"/>
            <rect x="42" y="60" width="22" height="55" rx="3" fill="#93c5fd"/>
            <rect x="74" y="40" width="22" height="75" rx="3" fill="#3b82f6"/>
            <rect x="106" y="20" width="22" height="95" rx="3" fill="#bfdbfe"/>
            <rect x="138" y="5" width="22" height="110" rx="3" fill="#60a5fa"/>
            <polyline points="21,75 53,55 85,35 117,15 149,2" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="149" cy="2" r="4" fill="white"/>
            <path d="M160 30 L170 10 L180 30" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <svg viewBox="0 0 80 80" class="w-20 h-20">
            <circle cx="40" cy="40" r="28" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="12"/>
            <circle cx="40" cy="40" r="28" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="12"
              stroke-dasharray="125 176" stroke-linecap="round" transform="rotate(-90 40 40)"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
